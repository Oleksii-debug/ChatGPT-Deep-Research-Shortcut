{
  "manifest_version": 3,
  "name": "ChatGPT Accessible Tool Picker",
  "version": "0.4.0",
  "description": "NVDA-friendly verified picker for ChatGPT image generation, web search and Deep Research with downloadable diagnostics.",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["src/matcher.js", "src/content.js"],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "open-tool-picker": {
      "suggested_key": {
        "default": "Ctrl+Shift+U",
        "windows": "Ctrl+Shift+U"
      },
      "description": "Open accessible ChatGPT tool picker"
    }
  },
  "action": {
    "default_title": "Open ChatGPT tool picker"
  }
}
